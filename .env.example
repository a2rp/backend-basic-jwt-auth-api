# Server port (optional; defaults to 1198)
PORT=1198

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/basic-jwt-auth

# Generate a random secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# JWT lifetime (default: 1h)
JWT_EXPIRES_IN=1h

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
